class Solution {
    public int compress(char[] chars) {
        int write = 0;  
        int i = 0;      
        
        while(i < chars.length){
            char ch = chars[i];
            int count = 1;

            while(i + 1 < chars.length && ch == chars[i + 1]){
                count++;
                i++;
            }
            
            i++;

            chars[write++] = ch;

            if(count > 1){
                String countStr = String.valueOf(count);
                for(char c : countStr.toCharArray()){
                    chars[write++] = c;
                }
            }
        }
        
        return write;
    }
}
